{
  "testEnvironment": "jsdom",
  "injectGlobals": true,
  "setupFilesAfterEnv": ["<rootDir>/resources/js/__tests__/setup.tsx"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/resources/js/$1"
  },
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [".ts", ".tsx"],
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx"],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "testMatch": [
    "<rootDir>/resources/js/**/__tests__/**/*.test.{ts,tsx,js,jsx}",
    "<rootDir>/test.js"
  ],
  "transformIgnorePatterns": [
    "node_modules/(?!(@inertiajs/react|@inertiajs/core)/)"
  ]
}
