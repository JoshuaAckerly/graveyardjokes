APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Auth-system shared database (owns users and page_seos for all projects)
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_DATABASE=auth_system
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_ANALYTICS_TRACKING_ID=G-1GXR54HSYZ
VISITOR_NOTIFICATION_TTL=300

# PayPal Configuration
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_LIVE_CLIENT_ID_HERE
VITE_PAYPAL_CHECKOUT_CLIENT_ID=YOUR_PAYPAL_CHECKOUT_LIVE_CLIENT_ID_HERE
VITE_PAYPAL_SANDBOX_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID_HERE
VITE_PAYPAL_ENVIRONMENT=production

# For CI/CD, see .env.ci for MySQL settings matching the workflow service.

GOOGLE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_CLIENT_ID=

# Google Business Profile API
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Format: accounts/{accountId}/locations/{locationId}
GOOGLE_BUSINESS_LOCATION_NAME=

# Google Places API (fallback while awaiting Business Profile API access)
# Enable Places API in Google Cloud Console, create a restricted API key
# Find your Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# Social Media Scheduler
DISCORD_WEBHOOK_URL=

# Twitter/X — https://developer.twitter.com/en/portal/projects-and-apps
# Create a Project + App → set permissions to "Read and Write" → generate Access Token & Secret
# TWITTER_API_KEY     = Consumer Key (under "Keys and Tokens")
# TWITTER_API_SECRET  = Consumer Secret
# TWITTER_ACCESS_TOKEN / TWITTER_ACCESS_SECRET = generated under "Authentication Tokens"
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Run `php artisan social:facebook-refresh --token=<short_lived_token>` to get a non-expiring page token

# Instagram — must be a professional/business account connected to a Facebook Page
# INSTAGRAM_USER_ID    = Instagram Business Account ID
#   → GET https://graph.facebook.com/v19.0/me/accounts?access_token=<page_token>
#     then GET https://graph.facebook.com/v19.0/<page_id>?fields=instagram_business_account&access_token=<page_token>
# INSTAGRAM_ACCESS_TOKEN = the same long-lived Facebook Page access token that manages the IG account
#   → Run `php artisan social:facebook-refresh --token=<short_lived_user_token>` to generate it
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Secret bearer token required to POST to /api/social/schedule from local machine
SOCIAL_SCHEDULE_SECRET=

